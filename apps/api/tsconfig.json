{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src"], "exclude": ["src/social_bad", "src/ai_corrupt", "src/social_bad_corrupt", "src/tests", "src/**/*.test.ts"]
}
